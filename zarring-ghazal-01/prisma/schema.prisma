generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  NEW
  READ
  CONTACTED
  CLOSED
}

model ContactRequest {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String?
  subject   String
  message   String
  status    RequestStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}